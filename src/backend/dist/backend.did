type _ImmutableObjectStorageRefillResult = 
 record {
   success: opt bool;
   topped_up_amount: opt nat;
 };
type _ImmutableObjectStorageRefillInformation = record {
                                                  proposed_top_up_amount:
                                                   opt nat;};
type _ImmutableObjectStorageCreateCertificateResult = 
 record {
   blob_hash: text;
   method: text;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UserProfile = 
 record {
   followerCount: nat;
   followingCount: nat;
   isFollowing: bool;
   "principal": principal;
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type PostView = 
 record {
   audio: ExternalBlob;
   caption: text;
   createdAt: int;
   filename: text;
   id: PostId;
   likeCount: nat;
   likedByCaller: bool;
   playCount: nat;
   repostCount: nat;
   repostedByCaller: bool;
   title: text;
   uploader: principal;
 };
type PostId = nat;
type PlaylistView = 
 record {
   createdAt: int;
   id: PlaylistId;
   name: text;
   trackIds: vec PostId;
 };
type PlaylistId = nat;
type MessageView = 
 record {
   createdAt: int;
   id: MessageId;
   sender: principal;
   "text": text;
 };
type MessageId = nat;
type FeedPage = 
 record {
   nextCursor: opt PostId;
   posts: vec PostView;
 };
type FeedFilter = 
 variant {
   following;
   forYou;
 };
type ExternalBlob = blob;
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type ConversationView = 
 record {
   id: ConversationId;
   lastMessage: opt text;
   lastMessageAt: opt int;
   otherUser: principal;
   unreadCount: nat;
 };
type ConversationId = nat;
type CommentView = 
 record {
   author: principal;
   createdAt: int;
   id: CommentId;
   parentId: opt CommentId;
   postId: PostId;
   replyCount: nat;
   "text": text;
 };
type CommentId = nat;
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  addComment: (postId: PostId, "text": text) -> (CommentId);
  addTrackToPlaylist: (playlistId: PlaylistId, postId: PostId) -> ();
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  createPlaylist: (name: text) -> (PlaylistId);
  deletePost: (postId: PostId) -> ();
  execute: (qJson: text) -> (Result) query;
  followUser: (target: principal) -> ();
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  getCommentCount: (postId: PostId) -> (nat) query;
  getComments: (postId: PostId) -> (vec CommentView) query;
  getConversation: (conversationId: ConversationId) ->
   (opt vec MessageView) query;
  getConversations: () -> (vec ConversationView) query;
  getFeed: (filter: FeedFilter, cursor: opt PostId, limit: nat) ->
   (FeedPage) query;
  getPlaylists: ("principal": principal) -> (vec PlaylistView) query;
  getPost: (postId: PostId) -> (opt PostView) query;
  getProfile: ("principal": principal) -> (UserProfile) query;
  getRecommendations: (limit: nat) -> (vec PostView) query;
  getUserPosts: ("principal": principal) -> (vec PostView) query;
  getUserReposts: ("principal": principal) -> (vec PostView) query;
  isCallerAdmin: () -> (bool) query;
  likePost: (postId: PostId) -> ();
  markConversationRead: (conversationId: ConversationId) -> ();
  recordPlay: (postId: PostId) -> ();
  replyToComment: (postId: PostId, parentId: CommentId, "text": text) ->
   (CommentId);
  repostPost: (postId: PostId) -> ();
  schema: () -> (text) query;
  sendMessage: (conversationId: ConversationId, "text": text) -> (MessageId);
  startConversation: (other: principal) -> (ConversationId);
  unfollowUser: (target: principal) -> ();
  unlikePost: (postId: PostId) -> ();
  unrepostPost: (postId: PostId) -> ();
  uploadPost: (title: text, caption: text, audio: ExternalBlob, filename:
   text) -> (PostId);
}
